{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/mbuc/error-envelope-v1.json",
  "title": "Corporate Error Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "code", "message", "correlation_id"],
  "properties": {
    "version": {"const": 1},
    "code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
    "message": {"type": "string", "minLength": 1, "maxLength": 512},
    "correlation_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{8,128}$"},
    "details": {
      "type": "object",
      "maxProperties": 32,
      "additionalProperties": {"type": ["string", "number", "integer", "boolean", "null"]}
    }
  }
}
