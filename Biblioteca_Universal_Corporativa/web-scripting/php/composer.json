{
  "name": "example/mbuc-security",
  "description": "Corporate AES-256-GCM envelope for PHP",
  "type": "library",
  "require": {"php": "^8.3", "ext-openssl": "*", "psr/log": "^3.0"},
  "require-dev": {"phpunit/phpunit": "^11.4", "phpstan/phpstan": "^2.1"},
  "autoload": {"psr-4": {"Mbuc\\Security\\": "src/"}},
