<?xml version="1.0" encoding="UTF-8"?>
<addons>
  <addon id="plugin.video.stv" name="sTv" version="0.7.8" provider-name="Saile">
    <requires>
      <import addon="xbmc.python" version="3.0.0" />
      <import addon="resource.images.saile" version="1.0.3" />
      <import addon="script.module.saile.core" version="1.0.1" />
      <import addon="script.module.saile.epg" version="1.3.0" />
    </requires>
    <extension point="xbmc.python.pluginsource" library="default.py">
      <provides>video</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
      <summary lang="pt_BR">Cliente IPTV local para provedores Xtream com EPG Oficial.</summary>
      <description lang="pt_BR">Exibição de canais da grade EPG oficial no primeiro nível com logos HD, canais fora da grade preservados em diretórios originais, Agora/Próximo e TMDB.</description>
      <disclaimer lang="pt_BR">Use apenas serviços e conteúdos para os quais você possua autorização.</disclaimer>
      <language>pt</language>
      <platform>all</platform>
      <license>GPL-3.0-or-later</license>
      <source>https://github.com/Bruno1991/sKodi_Addon</source>
      <news>0.7.8 - Integração do EPG Oficial Claro TV+, promoção de canais da grade com logos HD no 1º nível e preservação de canais não catalogados em suas pastas originais.</news>
      <assets>
        <icon>icon.png</icon>
        <fanart>fanart.jpg</fanart>
      </assets>
    </extension>
  </addon>
  <addon id="repository.srepo" name="sRepo" version="1.1.1" provider-name="Saile">
    <extension point="xbmc.addon.repository" name="sRepo">
      <dir minversion="19.0.0">
        <info compressed="false">https://bruno1991.github.io/sKodi_Addon/addons.xml</info>
        <checksum>https://bruno1991.github.io/sKodi_Addon/addons.xml.md5</checksum>
        <datadir zip="true">https://bruno1991.github.io/sKodi_Addon/zips/</datadir>
      </dir>
      <dir>
        <info compressed="false">https://bruno1991.github.io/sKodi_Addon/addons.xml</info>
        <checksum>https://bruno1991.github.io/sKodi_Addon/addons.xml.md5</checksum>
        <datadir zip="true">https://bruno1991.github.io/sKodi_Addon/zips/</datadir>
      </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
      <summary lang="pt_BR">Repositório oficial do ecossistema sKodi.</summary>
      <description lang="pt_BR">Instala e atualiza o sTv e seus módulos compartilhados pelo GitHub Pages.</description>
      <platform>all</platform>
      <license>GPL-3.0-or-later</license>
      <source>https://github.com/Bruno1991/sKodi_Addon</source>
      <news>1.1.1 - Atualiza endpoints de distribuição e compatibilidade Kodi.</news>
      <assets>
        <icon>icon.png</icon>
        <fanart>fanart.jpg</fanart>
      </assets>
    </extension>
  </addon>
  <addon id="resource.images.saile" name="sArtwork" version="1.0.3" provider-name="Saile">
    <extension point="kodi.resource.images" compile="false" />
    <extension point="xbmc.addon.metadata">
      <summary lang="pt_BR">Artes compartilhadas do ecossistema sKodi.</summary>
      <description lang="pt_BR">Ícones fixos e recursos visuais compartilhados utilizados pelo sTv.</description>
      <platform>all</platform>
      <license>GPL-3.0-or-later</license>
      <source>https://github.com/Bruno1991/sKodi_Addon</source>
      <news>1.0.3 - Restauração dos ícones originais de alta definição.</news>
      <assets>
        <icon>icon.png</icon>
        <fanart>fanart.jpg</fanart>
      </assets>
    </extension>
  </addon>
  <addon id="script.module.saile.core" name="sCore" version="1.0.1" provider-name="Saile">
    <requires>
      <import addon="xbmc.python" version="3.0.0" />
      <import addon="resource.images.saile" version="1.0.0" />
    </requires>
    <extension point="xbmc.python.module" library="lib" />
    <extension point="xbmc.addon.metadata">
      <summary lang="pt_BR">Infraestrutura Python compartilhada do ecossistema sKodi.</summary>
      <description lang="pt_BR">Caminhos portáveis, artwork compartilhado, notificações, erros e diagnóstico de capacidades.</description>
      <platform>all</platform>
      <license>GPL-3.0-or-later</license>
      <source>https://github.com/Bruno1991/sKodi_Addon</source>
      <news>1.0.1 - Atualização dos metadados e compatibilidade do ecossistema sKodi.</news>
      <assets>
        <icon>icon.png</icon>
        <fanart>fanart.jpg</fanart>
      </assets>
    </extension>
  </addon>
  <addon id="script.module.saile.epg" name="sEPG" version="1.3.0" provider-name="Saile">
    <requires>
      <import addon="xbmc.python" version="3.0.0" />
      <import addon="script.module.saile.core" version="1.0.1" />
    </requires>
    <extension point="xbmc.python.module" library="lib" />
    <extension point="xbmc.addon.metadata">
      <summary lang="pt_BR">Provedor oficial de guia de programação (EPG) e logos HD do ecossistema sKodi.</summary>
      <description lang="pt_BR">Integração com a API oficial da Claro TV+ como fonte da verdade, logos em alta resolução, limpeza automática de legado e Agora/Próximo em cache local SQLite.</description>
      <platform>all</platform>
      <license>GPL-3.0-or-later</license>
      <source>https://github.com/Bruno1991/sKodi_Addon</source>
      <news>1.3.0 - Provedor oficial Claro TV+ com logos em alta resolução e limpeza automática do banco legado.</news>
      <assets>
        <icon>icon.png</icon>
        <fanart>fanart.jpg</fanart>
      </assets>
    </extension>
  </addon>
</addons>